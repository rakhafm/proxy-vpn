# Salin ke /etc/proxy-pool.env di VM (BUKAN di repo - isinya kredensial):
#   tsh scp pool/deploy/proxy-pool.env.example root@asl-prd-prod-crawler-proxy-1:/etc/proxy-pool.env
#   tsh ssh root@asl-prd-prod-crawler-proxy-1 "chmod 600 /etc/proxy-pool.env"
# lalu edit langsung di VM untuk isi PROTON_KEY_SLOT_3.

# Mulai dari 3 slot (2 PIA + 1 Proton), bukan 6 - VM ini cuma 1.9 GB RAM
# tanpa swap, dan 6 slot penuh (~1.5 GB gluetun + ~500 MB probe browser)
# terlalu pas-pasan untuk dicoba langsung. Naikkan bertahap sambil pantau
# `free -h` di VM setelah beberapa hari rotasi stabil.
PIA_SLOTS=2
PROTON_SLOTS=0

# Slot TAMBAHAN yang pakai profil .ovpn dari config generator PIA (mode custom
# gluetun, jalur yang sama dengan legacy-ovpn/) alih-alih server bawaan image.
# Default 0 = mati; naikkan cuma kalau mau membandingkan kedua jalur
# berdampingan, dan ingat batas RAM VM di atas - tiap slot ini satu container
# gluetun penuh seperti slot lain. Kredensialnya sama (.pia-credentials).
# Profil di-download lewat pool/get-pia-ovpn.sh, di-cache di
# PIA_CUSTOM_PROFILE_DIR (default pool/vpn-profile/) dan dipakai ulang selama
# PIA_CUSTOM_PROFILE_MAX_AGE_HOURS (12) - jangan diperpendek jadi per rotasi,
# itu berarti login berkali-kali ke akun PIA dalam hitungan menit.
# Region diisi kode milik get-pia-ovpn.sh ("./pool/get-pia-ovpn.sh -l"),
# BUKAN hostname seperti POOL_CANDIDATE_GROUP di bawah.
PIA_CUSTOM_SLOTS=0
#PIA_CUSTOM_REGIONS=sg,jakarta,kualalumpur,philippines,vietnam

# Slot TAMBAHAN provider NordVPN (server bawaan gluetun, kandidat dari
# ./servers.sh nord sesuai POOL_CANDIDATE_GROUP di bawah). Default 0 = mati.
# Beda dari Proton, kredensialnya SATU akun untuk semua slot nord (lihat
# NORD_KEY / .nord-credentials di bawah); batasnya kuota perangkat akun Nord.
# Ingat batas RAM VM: tiap slot satu container gluetun penuh.
NORD_SLOTS=0

# Grup(s) untuk servers.sh, dipisah koma - kandidat pia dari SEA saja cuma 14
# server dan semuanya di ASN yang sama (AS212238 Datacamp), jadi sekali OLX
# menolak ASN itu daftar kandidat habis dalam satu putaran rotasi. Tambah
# China/JP Tokyo/Hong Kong/Taiwan/South Korea untuk ASN/exit range lain.
POOL_CANDIDATE_GROUP=sea,China,JP Tokyo,Hong Kong,Taiwan,South Korea
POOL_ADVERTISE_HOST=10.0.0.51
POOL_API_PORT=8080
POOL_DAILY_TIME=03:00
HOURLY_REFILL=0
PROBE_OUT_RETAIN_DAYS=14

# Banyak rotasi berakhir ERR_HTTP2_PROTOCOL_ERROR dari Chrome saat probe
# (ditemukan 2026-08-24). Sudah dicoba turunkan MTU jadi 1280 (dites di
# proxy-2 2026-08-24 ~10:26-10:28 UTC) - NOL perubahan, error yang sama persis
# tetap muncul di 5 exit Proton berbeda. Jadi ini KEMUNGKINAN BESAR BUKAN
# fragmentasi tunnel, tapi WAF/anti-bot yang mereset koneksi berdasar reputasi
# ASN (datacenter/VPN dikenal) - exit Indonesia residensial tidak pernah kena
# ini. Dibiarkan tetap diset (tidak berbahaya, cuma terbukti belum menolong
# kasus ini) - kosongkan untuk balik ke default gluetun apa adanya.
WIREGUARD_MTU=1280
OPENVPN_MSSFIX=1280

# Kredensial PIA dibaca dari file (.pia-credentials di WorkingDirectory),
# bukan env - lihat langkah 1 di output deploy.sh.

# Proton: wireguard (default, kunci per slot) atau openvpn (satu akun untuk
# SEMUA slot Proton - lihat .proton-credentials di bawah). Ganti mode VPN
# tidak mengubah exit IP yang dipakai (SERVER_HOSTNAMES sama untuk keduanya),
# jadi kalau masalah di atas memang soal reputasi ASN exit-nya, openvpn
# kemungkinan tidak menyelesaikannya juga - masih dites.
PROTON_VPN_TYPE=wireguard

# Kunci WireGuard Proton - SATU per slot Proton, digenerate khusus untuk
# slot ini di https://account.proton.me/u/2/vpn/WireGuard. Jangan pakai
# ulang kunci yang sama untuk slot lain (identitas per-perangkat). Cuma
# dipakai kalau PROTON_VPN_TYPE=wireguard.
PROTON_KEY_SLOT_3=

# Kredensial OpenVPN/IKEv2 Proton - SATU akun dibagi semua slot Proton
# (beda dari kunci WireGuard di atas). Bukan login akun Proton biasa - ambil
# dari https://account.proton.me/u/2/account-password, bagian "OpenVPN /
# IKEv2 username". Disalin ke .proton-credentials di WorkingDirectory
# (format sama seperti .pia-credentials), bukan lewat env. Cuma dipakai
# kalau PROTON_VPN_TYPE=openvpn.

# NordVPN: wireguard (default, NordLynx) atau openvpn. Kedua kredensialnya
# satu per akun, dibagi semua slot nord.
NORD_VPN_TYPE=wireguard

# Kunci WireGuard akun Nord - SATU untuk semua slot nord (Nord tidak
# menerbitkan kunci per perangkat). Ambil access token di
# https://my.nordaccount.com/dashboard/nordvpn/manual-configuration/ lalu:
#   curl -s -u token:<TOKEN> https://api.nordvpn.com/v1/users/services/credentials
# salin field nordlynx_private_key. Cuma dipakai kalau NORD_VPN_TYPE=wireguard.
NORD_KEY=

# Kredensial OpenVPN Nord = "service credentials" dari halaman yang sama di
# atas (BUKAN email+password akun). Disalin ke .nord-credentials di
# WorkingDirectory (format sama seperti .pia-credentials), bukan lewat env.
# Cuma dipakai kalau NORD_VPN_TYPE=openvpn.

# Opsional - webhook Discord (Server Settings > Integrations > Webhooks) untuk
# notifikasi kalau kolam kosong (0 slot aktif). Kosongkan untuk mematikan.
DISCORD_WEBHOOK_URL=

# Penanda mesin di tiap pesan Discord. Default = hostname VM, jadi biasanya
# tidak perlu diisi - set cuma kalau hostname aslinya tidak informatif.
# Wajib diperhatikan kalau proxy-1 dan proxy-2 memakai webhook yang SAMA:
# tanpa penanda ini pesan keduanya identik dan tidak bisa dibedakan.
#POOL_HOSTNAME=
